<?xml version="1.0"?>

<robot xmlns:xacro="https://www.ros.org/wiki/xacro">

    <!-- Industrial Blue -->
    <material name="blue">
        <color rgba="0.12 0.44 0.70 1.0"/>
    </material>

    <!-- Safety Orange -->
    <material name="orange">
        <color rgba="1.0 0.43 0.0 1.0"/>
    </material>

    <!-- Emergency / Alert Red -->
    <material name="red">
        <color rgba="0.85 0.15 0.15 1.0"/>
    </material>

    <!-- Active / Indicator Green -->
    <material name="green">
        <color rgba="0.15 0.75 0.25 1.0"/>
    </material>

    <!-- Warning / Caution Yellow -->
    <material name="yellow">
        <color rgba="0.95 0.80 0.10 1.0"/>
    </material>

    <!-- Cyan / Accent Light Blue -->
    <material name="cyan">
        <color rgba="0.0 0.75 0.85 1.0"/>
    </material>
        
    <material name="flange_steel">
    <color rgba="0.3 0.3 0.3 1.0"/>
    </material>
    
    <!-- Matte Black (Chassis, Mounts, Enclosures) -->
    <material name="black">
        <color rgba="0.08 0.08 0.08 1.0"/>
    </material>

    <!-- Dark Rubber (Wheel Treads, Bumpers) -->
    <material name="rubber_black">
        <color rgba="0.15 0.15 0.15 1.0"/>
    </material>

    <!-- Flange / Anodized Dark Steel -->
    <material name="dark_gray">
        <color rgba="0.25 0.25 0.28 1.0"/>
    </material>

    <!-- Medium Mechanical Gray -->
    <material name="gray">
        <color rgba="0.5 0.5 0.52 1.0"/>
    </material>

    <!-- Light Gray / Cast Aluminum -->
    <material name="aluminum">
        <color rgba="0.75 0.75 0.78 1.0"/>
    </material>

    <!-- Clean White (Covers, Panels, Cleanroom Bodies) -->
    <material name="white">
        <color rgba="0.95 0.95 0.95 1.0"/>
    </material>

    <!-- Polished Brass / Bushings -->
    <material name="brass">
        <color rgba="0.85 0.65 0.15 1.0"/>
    </material>

    <!-- Protective Polycarbonate / Glass Dome (Alpha = 0.35) -->
    <material name="transparent_glass">
        <color rgba="0.85 0.92 0.95 0.35"/>
    </material>

    <!-- Semi-Transparent Dark Acrylic (Lidar Domes / Shrouds) -->
    <material name="tinted_acrylic">
        <color rgba="0.1 0.1 0.1 0.45"/>
    </material>

    <!-- Laser / Sensor Optical Lens (Emissive Red Glow) -->
    <material name="laser_red">
        <color rgba="1.0 0.05 0.05 0.8"/>
    </material>


</robot>