<?xml version="1.0"?>

<robot  xmlns:xacro="https://www.ros.org/wiki/xacro">


    <!-- ==================== Veriables ==================== -->

    <xacro:property name="base_length" value="0.9"/>
    <xacro:property name="base_width" value="0.4"/>
    <xacro:property name="base_height" value="0.2"/>
    <xacro:property name="wheel_radius" value="0.1"/>
    <xacro:property name="wheel_length" value="0.05"/>
    <xacro:property name="front_wheel_radius" value="${wheel_radius/2}"/>

    <!-- ==================== Functions ==================== -->
    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel">  
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
                <material name="flange_steel"/>
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${wheel_radius}"/>        
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </collision>

            <xacro:cylinder_inertia m="1.0" r="${wheel_radius}" l="${wheel_length}" o_xyz="0 0 0" o_rpy="${pi/2.0} 0 0" />
        </link>
        
    </xacro:macro>

 
    <!-- ==================== Links & Joints  ==================== -->

    <!-- ==================== Base Link ==================== -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
        </collision>
        <xacro:box_inertia m="5.0" x="${base_length}" y="${base_width}" z="${base_height}" o_xyz="0 0 ${base_height/2}" o_rpy="0 0 0" />         
    </link>

    <link name="base_footprint"/>

    <joint name="origin_link" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <!-- ==================== Left Wheel ==================== -->
    <xacro:wheel_link prefix="left"/>

    <!-- Base to Left Wheel Joint -->
    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="${-base_length/4.0} ${-(base_width + wheel_length)/2} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- ==================== Right Wheel ==================== -->
    <xacro:wheel_link prefix="right"/>

    <!-- Base to right Wheel Joint -->
    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="${-base_length/4.0} ${(base_width + wheel_length)/2} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- ==================== Front Wheel ==================== -->
    <link name="front_wheel">
        <visual>
            <geometry>
                <sphere radius="${front_wheel_radius}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="flange_steel"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${front_wheel_radius}"/>        
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:sphere_inertia m="0.5" r="${front_wheel_radius}" o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <!-- Base to front Wheel Joint -->
    <joint name="base_front_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="front_wheel"/>
        <origin xyz="${base_length/3.0} 0 ${-front_wheel_radius}" rpy="0 0 0"/>
    </joint>


</robot>